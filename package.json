{
  "name": "rfl-bot",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "db:generate": "pnpm --filter @rfl-bot/db generate",
    "db:migrate": "pnpm --filter @rfl-bot/db migrate:dev",
    "db:deploy": "pnpm --filter @rfl-bot/db migrate:deploy",
    "db:check": "pnpm --filter @rfl-bot/db migrate:check",
    "db:studio": "pnpm --filter @rfl-bot/db studio",
    "services:up": "docker compose -f compose.dev.yaml up -d --wait",
    "services:down": "docker compose -f compose.dev.yaml down"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15",
    "turbo": "2.11.10",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
