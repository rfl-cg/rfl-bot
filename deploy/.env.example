# Produção. Copie para deploy/.env e preencha. Nunca coloque no Git.

# Senha do Postgres do RFL Bot. Gere com: openssl rand -hex 24
POSTGRES_PASSWORD=

# Chave para criptografar as chaves de API no banco. Gere com: openssl rand -base64 32
# Guarde uma cópia em lugar seguro: sem ela, os segredos salvos não abrem mais.
ENCRYPTION_KEY=

# Onde a API escuta na VPS. O proxy que já existe encaminha o domínio para cá.
# Se o proxy roda dentro do Docker, troque API_BIND para 172.17.0.1 (veja o README).
API_BIND=127.0.0.1
API_PUBLIC_PORT=3100

# Só para o Caddy incluso (VPS sem outro proxy nas portas 80/443):
# COMPOSE_PROFILES=caddy
# APP_DOMAIN=bot.seudominio.com.br

NODE_ENV=production
LOG_LEVEL=info
WORKER_HEARTBEAT_MS=30000
