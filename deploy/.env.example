# Produção. Copie para deploy/.env e preencha. Nunca coloque no Git.

# Senha do Postgres do RFL Bot. Gere com: openssl rand -hex 24
POSTGRES_PASSWORD=

# Chave para criptografar as chaves de API no banco. Gere com: openssl rand -base64 32
# Guarde uma cópia em lugar seguro: sem ela, os segredos salvos não abrem mais.
ENCRYPTION_KEY=

# Token entre o runner e os outros serviços. Gere com: openssl rand -hex 32
RUNNER_TOKEN=

# ── WhatsApp (via WhatsApp Web) ─────────────────────────────────────
# Telefones com DDI e DDD, só números (ex.: 5511999998888).
# Número do bot: um chip separado, não o seu número pessoal.
WHATSAPP_PHONE=
# O seu número: o único que dá comandos (/login, /bots…).
WHATSAPP_OWNER=
# Outros números que podem conversar com os bots, separados por vírgula.
WHATSAPP_ALLOWED=
# Limite de mensagens enviadas por minuto (reduz o risco de bloqueio).
WHATSAPP_MAX_PER_MINUTE=20

# ── Recursos (a VPS é compartilhada) ────────────────────────────────
# Quantos bots trabalham ao mesmo tempo.
MAX_CONCURRENT_TURNS=2
# Memória máxima do runner (onde os CLIs rodam).
RUNNER_MEMORY_LIMIT=1536M

# ── API ─────────────────────────────────────────────────────────────
# Onde a API escuta na VPS. O proxy que já existe encaminha o domínio para cá.
# Se o proxy roda dentro do Docker, troque API_BIND para 172.17.0.1 (veja o README).
API_BIND=127.0.0.1
API_PUBLIC_PORT=3100

# Só para o Caddy incluso (VPS sem outro proxy nas portas 80/443):
# COMPOSE_PROFILES=caddy
# APP_DOMAIN=bot.seudominio.com.br

NODE_ENV=production
LOG_LEVEL=info
TZ=America/Sao_Paulo
WORKER_HEARTBEAT_MS=30000
