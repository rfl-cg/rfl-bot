# Produção. Copie para deploy/.env e preencha. Nunca coloque no Git.

# Domínio apontado para o IP da VPS (registro A). O Caddy gera o HTTPS sozinho.
APP_DOMAIN=bot.seudominio.com.br

# Senha do Postgres. Gere com: openssl rand -hex 24
POSTGRES_PASSWORD=

# Chave para criptografar as chaves de API no banco. Gere com: openssl rand -base64 32
# Guarde uma cópia em lugar seguro: sem ela, os segredos salvos não abrem mais.
ENCRYPTION_KEY=

NODE_ENV=production
LOG_LEVEL=info
WORKER_HEARTBEAT_MS=30000
