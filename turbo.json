{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "generate": {
      "inputs": ["prisma/**", "prisma.config.ts"],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^generate"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^generate", "generate"]
    },
    "test": {
      "dependsOn": ["^generate", "generate"],
      "cache": false
    },
    "dev": {
      "dependsOn": ["^generate"],
      "cache": false,
      "persistent": true
    }
  }
}
