# Copie para .env e preencha. Nunca coloque o .env no Git.

NODE_ENV=development
LOG_LEVEL=info

# Serviços locais (pnpm services:up)
DATABASE_URL=postgresql://rflbot:rflbot@localhost:5432/rflbot
REDIS_URL=redis://localhost:6379

# Chave para criptografar as chaves de API no banco (32 bytes em base64).
# Gere com: openssl rand -base64 32
ENCRYPTION_KEY=

# API
API_HOST=0.0.0.0
API_PORT=3000

# Worker
WORKER_HEARTBEAT_MS=30000
# Quantos bots trabalham ao mesmo tempo
MAX_CONCURRENT_TURNS=2

# Runner ("computador dos bots"). Token compartilhado entre runner, worker e WhatsApp.
# Gere com: openssl rand -hex 32
RUNNER_TOKEN=
RUNNER_URL=http://localhost:4000
RUNNER_PORT=4000
# Em desenvolvimento, os logins dos CLIs e as pastas dos bots ficam em .data/ (fora do Git)
RUNNER_DATA_DIR=../../.data/runner
# Provedor "eco" (repete a mensagem) para testar sem login
RUNNER_ENABLE_ECHO=true

# WhatsApp (via WhatsApp Web). Telefones com DDI e DDD, só números.
# WHATSAPP_PHONE: o número do bot (chip separado). WHATSAPP_OWNER: o seu número.
WHATSAPP_PHONE=
WHATSAPP_OWNER=
# Outros números que podem conversar com os bots, separados por vírgula
WHATSAPP_ALLOWED=
WHATSAPP_AUTH_DIR=../../.data/whatsapp
WHATSAPP_MAX_PER_MINUTE=20
