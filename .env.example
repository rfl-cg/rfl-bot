# Copie para .env e preencha. Nunca coloque o .env no Git.

NODE_ENV=development
LOG_LEVEL=info

# Serviços locais (pnpm services:up)
DATABASE_URL=postgresql://rflbot:rflbot@localhost:5432/rflbot
REDIS_URL=redis://localhost:6379

# Chave para criptografar as chaves de API no banco (32 bytes em base64).
# Gere com: openssl rand -base64 32
ENCRYPTION_KEY=

# API
API_HOST=0.0.0.0
API_PORT=3000

# Worker
WORKER_HEARTBEAT_MS=30000

# ── Próximas fases (ainda não usados) ─────────────────────────────
# AUTH_SECRET=                # Fase 1: login (openssl rand -base64 32)
# ANTHROPIC_API_KEY=          # Fase 1: Claude
# TELEGRAM_BOT_TOKEN=         # Fase 1: Telegram (@BotFather)
# WHATSAPP_PHONE_NUMBER_ID=   # Fase 2: WhatsApp Cloud API
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# OPENAI_API_KEY=             # Fase 3: Codex
# XAI_API_KEY=                # Fase 3: Grok
# COMPOSIO_API_KEY=           # Fase 3: apps conectados
